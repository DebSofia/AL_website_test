# Copie para .env (local) ou configure em Netlify > Site configuration > Environment variables.
# NUNCA faça commit de chaves reais.

# URL pública do site (sem barra final). Usada nos redirecionamentos do Stripe.
SITE_URL=https://casadaribeira.example.com

# iCal de saída do Airbnb / Booking.com (extranet) - ver README
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=
# Feeds extra (opcional), separados por vírgula
EXTRA_ICAL_URLS=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# "true" depois de ativar MB WAY no painel Stripe
STRIPE_ENABLE_MBWAY=false

# Bloqueios manuais (opcional): JSON com intervalos [início, fim) - fim = dia de saída
# MANUAL_BLOCKS=[{"start":"2026-12-24","end":"2026-12-27","note":"Família"}]

# Token opcional para proteger /calendar.ics  (usar /calendar.ics?token=XXXX)
ICAL_EXPORT_TOKEN=
